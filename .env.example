# ==============================================================================
# AAGAM — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file or expose secrets in public repos.
# ==============================================================================

# Supabase Configuration
# Used by backend (api), frontend (web), and scheduled pipelines
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_public_key...
# SECRET: Service-role key is for backend API and pipeline only. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_secret_key...

# Postgres Database Connection URL (Direct or Pooler)
# Typically Supabase Session Pooler (port 5432) or Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Groq LLM Configuration (AAGAM Assistant)
# Free tier or Developer tier API key from https://console.groq.com
GROQ_API_KEY=gsk_...your_groq_api_key...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Open-Meteo Endpoints (Free tier / Non-commercial)
OPENMETEO_BASE_FORECAST=https://api.open-meteo.com/v1/forecast
OPENMETEO_BASE_HISTORICAL=https://archive-api.open-meteo.com/v1/archive

# Display & Regional Settings
APP_TZ_DISPLAY=Asia/Kolkata

# Backend Local Server Port
PORT=8000

# Frontend API URL (points to local FastAPI backend in dev, or Render URL in prod)
VITE_API_URL=http://localhost:8000
